	file = {PDF:C\:\\Users\\adunant\\Zotero\\storage\\AUFLVKBH\\Trucchia et al. - 2022 - Defining Wildfire Susceptibility Maps in Italy for Understanding Seasonal Wildfire Regimes at the Na.pdf:application/pdf},
