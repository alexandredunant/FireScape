	url = {https://linkinghub.elsevier.com/retrieve/pii/S1389934126001358},
	doi = {10.1016/j.forpol.2026.103830},
	abstract = {Climate change has increased wildfire pressure in the European Alps, yet a common understanding of fire regimes and coordinated fire management strategies remains lacking. This study analyzes the perceptions of three stakeholder groups in Austria, France, Germany, Italy, Slovenia, Liechtenstein, and Switzerland. An online survey and a forest fire workshop for experts were conducted to obtain different perceptions regarding the key factors and trends of the current and future fire regime. Our analysis indicates that there are significant differences between the groups regarding the perception of the number of fires, burnt areas, and future trends. Stakeholders identified precipitation, temperature, and wind as the main natural drivers of the fire regime, while recreational activities, rural abandonment, and owner awareness were identified as the main socio-economic drivers. These findings advance our understanding of the complex systems shaping future fire regimes in the European Alps and provide decision-makers with tools to design effective integrated fire management strategies.},
	language = {en},
	urldate = {2026-08-20},
