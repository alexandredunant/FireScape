	pages = {1005},
	file = {PDF:C\:\\Users\\adunant\\Zotero\\storage\\RD2A2KFP\\Miller et al. - 2025 - Compounding preconditions of wildfires vary in time and space within Europe.pdf:application/pdf},
}

